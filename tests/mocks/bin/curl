#!/bin/bash
# Mock curl for tests. Emits <body>\n<status> to match the -w format in http.sh.
# SEEDBOX_HTTP_FAIL=1 -> connection failure; SEEDBOX_HTTP_CODE overrides status.
if [[ "$SEEDBOX_HTTP_FAIL" == "1" ]]; then
  echo "curl: (7) Failed to connect to host" >&2
  exit 7
fi
url="${*: -1}"
code="${SEEDBOX_HTTP_CODE:-200}"
default_torrents='{"items":[{"hash":"H1","name":"Some.Movie.2024","size":2147483648,"is_multi":false,"base_rel":"files/Some.Movie.2024.mkv","finished":100},{"hash":"H2","name":"Some.Show.S01","size":10737418240,"is_multi":true,"base_rel":"files/Some.Show.S01","finished":200}]}'
case "$url" in
  */torrents) body="${SEEDBOX_TORRENTS_JSON:-$default_torrents}" ;;
  */jobs)     body="${SEEDBOX_JOBS_JSON:-{\"jobs\":[]}}" ;;
  */jobs/*)   body='{"id":"J1","state":"active"}' ;;
  *)          body='{}' ;;
esac
if [[ "$code" != 2* ]]; then
  body="${SEEDBOX_ERR_JSON:-{\"detail\":\"boom\"}}"
fi
printf '%s\n%s' "$body" "$code"
exit 0
